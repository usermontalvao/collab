# Copie para .env (o .env NÃO vai para o GitHub) e preencha.
# Os nomes são os MESMOS que o CRM já usa no Supabase — dá para copiar os valores
# sem mudar nada.

# --- Nextcloud: de onde o documento vem e para onde volta -------------------
# A mesma raiz que está no Supabase (só o domínio, sem /remote.php/...):
NEXTCLOUD_URL=https://nextcloud.jurius-api.com
NEXTCLOUD_USER=
# A mesma senha de app que está no Supabase:
NEXTCLOUD_APP_PASSWORD=

# --- Supabase: valida quem está chamando (o login do CRM) -------------------
# Mesmos valores do .env do CRM (VITE_SUPABASE_URL e VITE_SUPABASE_ANON_KEY):
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=

# --- Syncfusion -------------------------------------------------------------
# Mesmo valor de VITE_SYNCFUSION_LICENSE_KEY no .env do CRM:
SYNCFUSION_LICENSE_KEY=

# --- Opcionais ---------------------------------------------------------------
# Origens do CRM que podem chamar o serviço (separadas por vírgula):
COLLAB_ALLOWED_ORIGINS=https://jurius.com.br,https://www.jurius.com.br

# Exigir que quem edita esteja logado no CRM. Deixe true:
COLLAB_AUTH_REQUIRE=true

# Página inicial de status/demonstração. Depois de validar, pode virar false:
COLLAB_DEMO_ENABLED=true
