<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Jurius.CollabEditing</RootNamespace>
    <!--
      IMPORTANTE: precisa bater EXATAMENTE com a versão do npm
      @syncfusion/ej2-documenteditor usada no front. Formato SFDT e operações
      mudam entre versões — e o front resolvia 32.1.21 enquanto aqui estava
      preso em 32.1.19. O package.json do CRM está pinado (sem `^`) na mesma
      versão justamente para não voltar a divergir sozinho.
    -->
    <SyncfusionVersion>32.1.21</SyncfusionVersion>
  </PropertyGroup>

  <!-- Os testes têm o próprio projeto; sem isto o SDK Web os compilaria aqui. -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <Content Remove="tests/**" />
    <None Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="8.0.11" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Syncfusion.EJ2.WordEditor.AspNet.Core" Version="$(SyncfusionVersion)" />
    <PackageReference Include="Syncfusion.Licensing" Version="$(SyncfusionVersion)" />
  </ItemGroup>

</Project>
