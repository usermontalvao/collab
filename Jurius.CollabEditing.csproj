<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Jurius.CollabEditing</RootNamespace>
    <!--
      IMPORTANTE: precisa bater com a versão do npm @syncfusion/ej2-documenteditor
      usada no front (hoje 32.1.19). Formato SFDT e operações mudam entre versões.
    -->
    <SyncfusionVersion>32.1.19</SyncfusionVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="8.0.11" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Syncfusion.EJ2.WordEditor.AspNet.Core" Version="$(SyncfusionVersion)" />
    <PackageReference Include="Syncfusion.Licensing" Version="$(SyncfusionVersion)" />
  </ItemGroup>

</Project>
